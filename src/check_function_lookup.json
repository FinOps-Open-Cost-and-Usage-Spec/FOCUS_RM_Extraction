{
  "{entity} MUST be of type String.": {
    "Function": "Type",
    "ValidationCriteria": {
      "Requirement": {
        "CheckFunction": "TypeString",
        "ColumnName": "{entity}"
      }
    }
  },
  "{entity} MUST be of type Date/Time.": {
    "Function": "Type",
    "ValidationCriteria": {
      "Requirement": {
        "CheckFunction": "TypeDateTime",
        "ColumnName": "{entity}"
      }
    }
  },
  "{entity} MUST be of type Decimal.": {
    "Function": "Type",
    "ValidationCriteria": {
      "Requirement": {
        "CheckFunction": "TypeDecimal",
        "ColumnName": "{entity}"
      }
    }
  },
  "{entity} MUST NOT be null.": {
    "Function": "Nullability",
    "ValidationCriteria": {
      "Requirement": {
        "CheckFunction": "CheckNotValue",
        "ColumnName": "{entity}",
        "Value": null
      }
    }
  },
  "{entity} SHOULD NOT be null.": {
    "Function": "Nullability",
    "ValidationCriteria": {
      "Requirement": {
        "CheckFunction": "CheckNotValue",
        "ColumnName": "{entity}",
        "Value": null
      }
    }
  },
  "{entity} MAY be null.": {
    "Function": "Nullability",
    "ValidationCriteria": {
      "Requirement": {
        "CheckFunction": "CheckValue",
        "ColumnName": "{entity}",
        "Value": null
      }
    }
  },
  "{entity} MUST conform to StringHandling requirements.": {
    "Function": "Format",
    "ValidationCriteria": {
      "Requirement": {
        "CheckFunction": "FormatString",
        "ColumnName": "{entity}"
      }
    }
  },
  "{entity} MUST conform to DateTimeFormat requirements.": {
    "Function": "Format",
    "ValidationCriteria": {
      "Requirement": {
        "CheckFunction": "FormatDateTime",
        "ColumnName": "{entity}"
      }
    }
  },
  "{entity} MUST conform to NumericFormat requirements.": {
    "Function": "Format",
    "ValidationCriteria": {
      "Requirement": {
        "CheckFunction": "FormatNumeric",
        "ColumnName": "{entity}"
      }
    }
  },
  "{entity} MUST conform to CurrencyFormat requirements.": {
    "Function": "Format",
    "ValidationCriteria": {
      "Requirement": {
        "CheckFunction": "FormatCurrency",
        "ColumnName": "{entity}"
      }
    }
  },
  "{entity} MUST conform to JsonObjectFormat requirements.": {
    "Function": "Format",
    "ValidationCriteria": {
      "Requirement": {
        "CheckFunction": "FormatJSON",
        "ColumnName": "{entity}",
        "Path": "$"
      }
    }
  },
  "{entity} MUST conform to KeyValueFormat requirements.": {
    "Function": "Format",
    "ValidationCriteria": {
      "Requirement": {
        "CheckFunction": "FormatKeyValue",
        "ColumnName": "{entity}"
      }
    }
  },
  "{entity} SHOULD conform to UnitFormat requirements.": {
    "Function": "Format",
    "ValidationCriteria": {
      "Requirement": {
        "CheckFunction": "FormatUnit",
        "ColumnName": "{entity}"
      }
    }
  },
  "{entity} MUST equal BilledCost when ChargeCategory is \"Credit\".": {
    "Function": "Validation",
    "ValidationCriteria": {
      "Condition": {
        "CheckFunction": "CheckValue",
        "ColumnName": "ChargeCategory",
        "Value": "Credit"
      },
      "Requirement": {
        "CheckFunction": "CheckSameValue",
        "ColumnAName": "{entity}",
        "ColumnBName": "BilledCost"
      }
    }
  },
  "{entity} MUST have one and only one parent SkuId for a given ServiceProviderName.": {
    "Function": "Validation",
    "ValidationCriteria": {
      "Requirement": {
        "CheckFunction": "CheckDistinctCount",
        "ColumnAName": "{entity}",
        "ColumnBName": "SkuId",
        "ExpectedCount": 1
      }
    }
  },
  "{entity} MUST have one and only one PricingUnit for a given ServiceProviderName.": {
    "Function": "Validation",
    "ValidationCriteria": {
      "Requirement": {
        "CheckFunction": "CheckDistinctCount",
        "ColumnAName": "{entity}",
        "ColumnBName": "PricingUnit",
        "ExpectedCount": 1
      }
    }
  },
  "Property value MUST be one of the allowed values specified for that property when allowed values are specified.": {
    "Function": "Validation",
    "ValidationCriteria": {
      "Requirement": {
        "CheckFunction": "AND",
        "Items": [
          {
            "CheckFunction": "OR",
            "Items": [
              { "CheckFunction": "JSONCheckPathValue", "ColumnName": "{entity}", "Path": "$.TokenDirection", "Value": null },
              { "CheckFunction": "JSONCheckPathValue", "ColumnName": "{entity}", "Path": "$.TokenDirection", "Value": "Input" },
              { "CheckFunction": "JSONCheckPathValue", "ColumnName": "{entity}", "Path": "$.TokenDirection", "Value": "Output" }
            ]
          },
          {
            "CheckFunction": "OR",
            "Items": [
              { "CheckFunction": "JSONCheckPathValue", "ColumnName": "{entity}", "Path": "$.TokenCacheAction", "Value": null },
              { "CheckFunction": "JSONCheckPathValue", "ColumnName": "{entity}", "Path": "$.TokenCacheAction", "Value": "Read" },
              { "CheckFunction": "JSONCheckPathValue", "ColumnName": "{entity}", "Path": "$.TokenCacheAction", "Value": "Write" },
              { "CheckFunction": "JSONCheckPathValue", "ColumnName": "{entity}", "Path": "$.TokenCacheAction", "Value": "Uncached" },
              { "CheckFunction": "JSONCheckPathValue", "ColumnName": "{entity}", "Path": "$.TokenCacheAction", "Value": "Other" }
            ]
          }
        ]
      }
    }
  },
  "{entity} MUST NOT be associated with both a \"Usage\" ChargeCategory and a \"Purchase\" ChargeCategory for a given ServiceProviderName.": {
    "Function": "Validation",
    "ValidationCriteria": {
      "Condition": {
        "CheckFunction": "OR",
        "Items": [
          { "CheckFunction": "CheckValue", "ColumnName": "ChargeCategory", "Value": "Usage" },
          { "CheckFunction": "CheckValue", "ColumnName": "ChargeCategory", "Value": "Purchase" }
        ]
      },
      "Requirement": {
        "CheckFunction": "CheckDistinctCount",
        "ColumnAName": "{entity}",
        "ColumnBName": "ChargeCategory",
        "ExpectedCount": 1
      }
    }
  }
}
