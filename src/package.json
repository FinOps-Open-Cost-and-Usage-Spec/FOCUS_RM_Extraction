{
  "name": "focus-requirements-model-extraction",
  "version": "0.1.0",
  "private": true,
  "description": "MVP extractor that generates Requirements Model JSON from FOCUS specification markdown.",
  "type": "commonjs",
  "scripts": {
    "extract": "node extract_rm.js",
    "verify": "node verify.js",
    "diff": "node diff_model.js",
    "validate": "node validate_markdown.js",
    "extract:fixtures": "node extract_rm.js --specification test/fixtures/specification --baseline test/fixtures/baseline --output .fixture-output",
    "verify:fixtures": "node verify.js --specification test/fixtures/specification --baseline test/fixtures/baseline --output .fixture-output",
    "validate:fixtures": "node validate_markdown.js --specification test/fixtures/specification",
    "diff:fixtures": "node diff_model.js --baseline test/fixtures/baseline --output .fixture-output",
    "test": "node --test"
  },
  "dependencies": {
    "marked": "^12.0.0"
  }
}
